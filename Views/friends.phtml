<!--View for the friends.php controller. Uses $view->incomingFriendRequests,
$view->outgoingFriendRequests and $view->friends which the controller fills in. Each
entry holds the user's details and request id. The view only displays
things, the sorting logic takes place in the controller. -->
<?php require_once("template/header.phtml"); ?>

<h3> Your requests!</h3>

<!-- Requests sent to the logged-in user. A message is shown if there aren't any. -->
<?php if (empty($view->incomingFriendRequests)) { ?>
    <p>No pending requests :(</p>
<?php } ?>

<!-- One card for each incoming request, with the sender's picture and name outputted with
htmlspecialchars. Accept and Decline are separate forms that "POST" the request id
to their controllers. -->
<?php foreach ($view->incomingFriendRequests as $request) { ?>
    <div class="card mb-3">
        <div class="card-body d-flex align-items-start">
            <img src="<?php echo htmlspecialchars($request["user"]->getPhotoPath()); ?>"
                 alt="<?php echo htmlspecialchars($request["user"]->getUsername()); ?>"
                 class="rounded-circle me-3" width="100" height="100">
            <div class="me-auto">
                <h5 class="mb-0 fw-bold"><?php echo htmlspecialchars($request["user"]->getUsername()); ?></h5>
                <small class="text-muted">wants to be your friend!</small>
            </div>

            <form method="post" action="acceptrequest.php" class="d-inline">
                <input type="hidden" name="requestId" value="<?php echo (int)$request["requestId"]; ?>">
                <button type="submit" class="btn btn-sm btn-success">Accept request</button>
            </form>

            <form method="post" action="declinerequest.php" class="d-inline">
                <input type="hidden" name="requestId" value="<?php echo (int)$request["requestId"]; ?>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Decline request</button>
            </form>
        </div>
    </div>
<?php } ?>

<h5 class="mt-4">Requests you sent!</h5>

<!-- Requests the logged-in user sent that are still pending. A message is shown
if there are none. -->
<?php if (empty($view->outgoingFriendRequests)) { ?>
    <p>No sent requests :(</p>
<?php } ?>

<!--One card for each outgoing request, with a cancel button that posts to
 cancelfriendrequest.php -->
<?php foreach ($view->outgoingFriendRequests as $request) { ?>
    <div class="card mb-2">
        <div class="card-body d-flex align-items-start">
            <img src="<?php echo htmlspecialchars($request["user"]->getPhotoPath()); ?>"
                 alt="<?php echo htmlspecialchars($request["user"]->getUsername()); ?>"
                 class="rounded-circle me-3" width="100" height="100">
            <div class="me-auto">
                <h5 class="mb-0 fw-bold"><?php echo htmlspecialchars($request["user"]->getUsername()); ?></h5>
            </div>
            <span class="badge bg-secondary">You have requested...</span>
            <form method="post" action="cancelfriendrequest.php" class="d-inline">
                <input type="hidden" name="requestId" value="<?php echo (int)$request["requestId"]; ?>">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel request</button>
            </form>

        </div>
    </div>

<?php } ?>

<h5 class="mt-4">Current Friends!</h5>

<!--Accepted friends. A message is shown if there are none. -->
<?php if (empty($view->friends)) { ?>
    <p>Boo...no friends.. :(</p>
<?php } ?>

<!-- One card for each friend, with an unfriend button that posts to
removeexistingfriend.php -->
<?php foreach ($view->friends as $request) { ?>
    <div class="card mb-2">
        <div class="card-body d-flex align-items-start">
            <img src="<?php echo htmlspecialchars($request["user"]->getPhotoPath()); ?>"
                 alt="<?php echo htmlspecialchars($request["user"]->getUsername()); ?>"
                 class="rounded-circle me-3" width="100" height="100">
            <div class="me-auto">
                <h5 class="mb-0 fw-bold"><?php echo htmlspecialchars($request["user"]->getUsername()); ?></h5>
            </div>
            <span class="badge bg-success">Friends!</span>
            <form method="post" action="removeexistingfriend.php" class="d-inline">
                <input type="hidden" name="requestId" value="<?php echo (int)$request["requestId"]; ?>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Unfriend</button>
            </form>
        </div>
    </div>

<?php } ?>


<?php require('template/footer.phtml') ?>





